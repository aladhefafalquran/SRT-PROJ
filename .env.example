# SRT-Proj environment variables
# Copy this file to .env and fill in the real values; .env is gitignored.

# --- Required for the /translate_srt feature ---
# DeepL API key. The previous leaked key has been rotated and is no longer
# shipped with the source. If the variable is missing, the translate
# endpoint returns HTTP 500 with a clear error message.
DEEPL_API_KEY=

# --- Optional overrides ---
# Where uploaded files land. Defaults to <repo>/uploads.
# SRTPROJ_UPLOAD_FOLDER=/var/lib/srtproj/uploads
# Where finished files are written. Defaults to <repo>/outputs.
# SRTPROJ_OUTPUT_FOLDER=/var/lib/srtproj/outputs
# Maximum upload size in bytes. Default: 2147483648 (2 GiB).
# SRTPROJ_MAX_CONTENT_LENGTH=2147483648
# Server bind address and port.
# SRTPROJ_HOST=0.0.0.0
# SRTPROJ_PORT=5000
# Enable Flask debug mode (NEVER on in production).
# SRTPROJ_DEBUG=0
